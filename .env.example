# Copy this file to .env and fill in your real key.
# Never commit .env — it is listed in .gitignore.

# Groq API key
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: Groq model (default: openai/gpt-oss-120b)
# Supported production models: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: override the default port (default: 3000)
# PORT=3000
