# Copy this file to .env and fill in your real key.
# Never commit .env — it is listed in .gitignore.

# Groq API key
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: Groq model (default: llama-3.3-70b-versatile)
# Supported production models: llama-3.3-70b-versatile, llama-3.1-8b-instant
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: override the default port (default: 3000)
# PORT=3000
